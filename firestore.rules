rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
             (getUserData().get('role', 'member') == 'admin' || 
              getUserData().get('role', 'member') == 'Admin' ||
              getUserData().get('role', 'member') == 'superadmin' ||
              getUserData().get('role', 'member') == 'SuperAdmin');
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
             (getUserData().get('role', 'member') == 'superadmin' ||
              getUserData().get('role', 'member') == 'SuperAdmin');
    }

    // An archived (soft-deleted) member must not act on any data, even if their
    // auth token has not expired yet. `.get(..., false)` keeps legacy documents
    // that have no `isDeleted` field working as before.
    function isActiveUser() {
      return isAuthenticated() && 
             getUserData().get('status', 'active') == 'active' &&
             getUserData().get('isDeleted', false) == false;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─── Users / Members ───────────────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read their own doc; admins can read all
      allow read:   if isOwner(userId) || isAdmin();

      // User creates their own doc on registration
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Members can update their own doc but NOT change role, status or the
      // soft-delete / restore flags (those are admin-only operations).
      allow update: if (isOwner(userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['role', 'status', 'isDeleted', 'deletedAt', 'deletedBy', 'deletedByName']))
                    || isAdmin();

      // Only admin/superadmin can hard-delete a user doc.
      // The normal "Delete Member" workflow is a soft delete (updateDoc) so that
      // member data always stays recoverable from the Archived Members page.
      allow delete: if isAdmin();
    }

    // ─── Meetings ──────────────────────────────────────────────────────────
    match /meetings/{meetingId} {
      allow read:                    if isAdmin() || isActiveUser();
      allow create, delete:          if isAdmin();
      allow update:                  if isAdmin() || (
        isActiveUser() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendanceCount'])
      );
    }

    // ─── Attendance ────────────────────────────────────────────────────────
    match /attendance/{docId} {
      allow read: if isAdmin() || isActiveUser();

      // Enforce Idempotency + Auth + Meeting Status
      allow create: if isActiveUser() && (
                      docId == request.resource.data.meetingId + "_" + request.resource.data.memberUID && (
                        isAdmin() || (
                          request.resource.data.memberUID == request.auth.uid &&
                          get(/databases/$(database)/documents/meetings/$(request.resource.data.meetingId)).data.status == "active"
                        )
                      )
                    );
      allow update, delete: if isAdmin();
    }

    // ─── Complaints ────────────────────────────────────────────────────────
    match /complaints/{complaintId} {
      // Member sees their own; admin sees all
      allow read:   if isActiveUser() && (
                      resource.data.submittedByUID == request.auth.uid || isAdmin()
                    );
      allow create: if isActiveUser();
      allow update, delete: if isAdmin();
    }

    // ─── Notifications ─────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:   if isActiveUser();
      allow create: if isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'Admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'superadmin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'SuperAdmin'
      );
      allow delete: if isActiveUser();
      // Any active user can mark notification as read or dismiss it
      allow update: if isActiveUser() &&
                    request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['readBy', 'dismissedBy']);
    }

    // ─── Shops ─────────────────────────────────────────────────────────────
    match /shops/{shopId} {
      allow read:                    if isActiveUser();
      allow create, update, delete:  if isAdmin();
    }

    // ─── Shop Scans ────────────────────────────────────────────────────────
    match /shopScans/{scanId} {
      allow read: if isAdmin() || (isActiveUser() && resource.data.memberUid == request.auth.uid);
      allow create: if isActiveUser() && request.resource.data.memberUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── Payments ──────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      // Member sees own payments; admin sees all
      allow read:   if isActiveUser() && (
                      resource.data.memberUID == request.auth.uid || isAdmin()
                    );
      allow create, update, delete: if isAdmin();
    }

    // ─── Products / Inventory ──────────────────────────────────────────────
    match /products/{productId} {
      allow read:                    if isAdmin() || isActiveUser();
      allow create, update, delete:  if isAdmin();
    }

    // ─── Presidents ────────────────────────────────────────────────────────
    match /presidents/{presidentId} {
      allow read:                    if isAuthenticated();
      allow create, update, delete:  if isAdmin();
    }

    // ─── Customers ─────────────────────────────────────────────────────────
    // Admins manage every customer record. Members may create their own
    // customer / service records (including a photo) and may read or edit only
    // the records they created — they can never touch another member's record,
    // and deletion stays an admin-only management operation.
    match /customers/{customerId} {
      allow read: if isAdmin() || (
                    isActiveUser() && resource.data.createdByUID == request.auth.uid
                  );

      // A member may only create records stamped with their own uid.
      allow create: if isAdmin() || (
                       isActiveUser() &&
                       request.resource.data.createdByUID == request.auth.uid
                     );

      // Owners may edit their own record but must not re-assign ownership.
      allow update: if isAdmin() || (
                       isActiveUser() &&
                       resource.data.createdByUID == request.auth.uid &&
                       request.resource.data.createdByUID == request.auth.uid
                     );

      allow delete: if isAdmin();
    }

    // ─── Manual Bills / Service Details ────────────────────────────────────
    // Every field is manually entered by the user — the rules below only guard
    // ownership, they never generate or derive any value.
    match /serviceBills/{billId} {
      // Admins see every record; members see only the records they created.
      allow read: if isActiveUser() && (
                    isAdmin() || resource.data.createdByUID == request.auth.uid
                  );

      // A member may only create records stamped with their own uid.
      allow create: if isActiveUser() &&
                       request.resource.data.createdByUID == request.auth.uid;

      // Owners may edit their own record but must not re-assign ownership.
      allow update: if isAdmin() || (
                       isActiveUser() &&
                       resource.data.createdByUID == request.auth.uid &&
                       request.resource.data.createdByUID == request.auth.uid
                     );

      // Only admins may permanently remove a bill record.
      allow delete: if isAdmin();
    }

    // ─── Deny all else ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
